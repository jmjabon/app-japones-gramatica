[
  {
    "block_id": "g_block_01",
    "block_title": "Bloque 1: Fundamentos y Estados",
    "themes": [
      {
        "theme_id": "g_tema_1_1",
        "theme_title": "La Cópula Base",
        "status": "unlocked",
        "theory": {
          "formula": "<span class='color-sujeto'>[Sujeto]</span> <span class='color-particula'>は</span> [Sust/Adj] <span class='color-verbo'>です</span>",
          "explanation": "La partícula は (wa) marca de quién estamos hablando. El verbo です (desu) equivale a 'ser' y siempre va al final. <br><br><b>La Negación:</b> Para decir 'NO ser', el bloque <b>です</b> se convierte entero en <b>ではありません</b> (dewa arimasen). Fíjate en que sigue usando la letra は al principio, pero aquí forma parte de la palabra 'dewa'.",
          "examples": [
            {
              "ja": "<ruby>私<rt>わたし</rt></ruby>は<ruby>学生<rt>がくせい</rt></ruby>です。",
              "romaji": "Watashi wa gakusei desu.",
              "es": "Yo soy estudiante."
            },
            {
              "ja": "<ruby>私<rt>わたし</rt></ruby>は<ruby>犬<rt>いぬ</rt></ruby>ではありません。",
              "romaji": "Watashi wa inu dewa arimasen.",
              "es": "Yo no soy un perro."
            }
          ]
        },
        "exercises": [
            {
                "type": "scramble",
                "es": "Yo soy estudiante.",
                "expected": ["私", "は", "学生", "です"],
                "distractors": ["が", "を"]
            },
            {
                "type": "cloze",
                "es": "El Sr. Tanaka es profesor.",
                "ja_template": "田中さん [?] 先生 です。",
                "expected": "は",
                "distractors": ["が", "を", "に", "で"]
            },
            {
                "type": "classifier",
                "instruction": "Clasifica si la frase es una afirmación o una negación",
                "categories": ["Afirmación (desu)", "Negación (dewa arimasen)"],
                "items": [
                    { "word": "学生 です", "expected": "Afirmación (desu)", "rule": "Termina en です, por lo tanto está afirmando el estado." },
                    { "word": "先生 ではありません", "expected": "Negación (dewa arimasen)", "rule": "Termina en ではありません, es la negación formal." },
                    { "word": "日本人 です", "expected": "Afirmación (desu)", "rule": "Usa la cópula afirmativa です." }
                ]
            },
            {
                "type": "cloze",
                "es": "Yo no soy estudiante.",
                "ja_template": "私 は 学生 [?]。",
                "expected": "ではありません",
                "distractors": ["です", "ません", "ではない"]
            }
        ]
      },
      {
        "theme_id": "g_tema_1_2",
        "theme_title": "Adjetivos tipo I (い)",
        "status": "locked",
        "theory": {
          "formula": "<span class='color-sujeto'>[Sujeto]</span> <span class='color-particula'>は</span> [Raíz Adj-I] <span class='color-verbo'>くない です</span>",
          "explanation": "Los adjetivos que terminan en い (i) tienen su propia regla de conjugación. Para hacerlos negativos, quitas la 'い' final y añades 'くない' (kunai). Excepción: 'ii' (bueno) se convierte en 'yokunai'.",
          "examples": [
            {
              "ja": "この<ruby>本<rt>ほん</rt></ruby>は<ruby>高<rt>たか</rt></ruby>いです。",
              "romaji": "Kono hon wa takai desu.",
              "es": "Este libro es caro."
            },
            {
              "ja": "この<ruby>本<rt>ほん</rt></ruby>は<ruby>高<rt>たか</rt></ruby>くないです。",
              "romaji": "Kono hon wa takakunai desu.",
              "es": "Este libro no es caro."
            }
          ]
        },
        "exercises": [
            {
                "type": "scramble",
                "es": "El coche no es nuevo.",
                "expected": ["車", "は", "新しくない", "です"],
                "distractors": ["新しい", "ではありません"]
            },
            {
                "type": "cloze",
                "es": "La película no es interesante.",
                "ja_template": "映画 は 面白[?] です。",
                "expected": "くない",
                "distractors": ["い", "ではない", "かった"]
            },
            {
                "type": "classifier",
                "instruction": "Clasifica el estado del adjetivo",
                "categories": ["Afirmativo (-i)", "Negativo (-kunai)"],
                "items": [
                    { "word": "新しい です", "expected": "Afirmativo (-i)", "rule": "Mantiene la 'i' final antes del desu." },
                    { "word": "大きくない です", "expected": "Negativo (-kunai)", "rule": "Ha cambiado su terminación a kunai." },
                    { "word": "高くない です", "expected": "Negativo (-kunai)", "rule": "Significa 'no es caro/alto'." }
                ]
            }
        ]
      },
      {
        "theme_id": "g_tema_1_3",
        "theme_title": "Adjetivos tipo NA (な)",
        "status": "locked",
        "theory": {
          "formula": "<span class='color-sujeto'>[Sujeto]</span> <span class='color-particula'>は</span> [Adj-NA] <span class='color-verbo'>ではありません</span>",
          "explanation": "Los adjetivos tipo NA (como しずか - tranquilo) son diferentes: se comportan exactamente igual que los sustantivos. Para negarlos, NO usas 'kunai', usas ではありません (dewa arimasen). La 'na' solo aparece cuando se pegan a un sustantivo.",
          "examples": [
