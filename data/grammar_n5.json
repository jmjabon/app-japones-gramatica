                "expected": "ではありません",
                "distractors": ["くないです", "です", "くない"]
            },
            {
                "type": "scramble",
                "es": "La habitación no es tranquila.",
                "expected": ["部屋", "は", "静か", "ではありません"],
                "distractors": ["くない", "です"]
            }
        ]
      },
      {
