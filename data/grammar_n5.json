                "es": "Ayer fui a Kioto.",
                "ja_template": "きのう、京都 へ 行き[?]。",
                "expected": "ました",
                "distractors": ["ます", "ませんでした", "ません"]
            },
            {
                "type": "scramble",
                "es": "No vi la televisión.",
                "expected": ["テレビ", "を", "見ませんでした"],
                "distractors": ["見ました", "です"]
            }
        ]
      },
      {
        "theme_id": "g_tema_2_4",
        "theme_title": "Invitaciones y Propuestas",
        "status": "locked",
        "theory": {
          "formula": "<span class='color-verbo'>V-ませんか / V-ましょう</span>",
          "explanation": "Para invitar a alguien, usa la forma negativa interrogativa <b>ませんか</b> (masen ka) que significa '¿No te gustaría...?'. Para proponer hacer algo juntos, usa <b>ましょう</b> (mashou) que significa '¡Hagamos...! / Let's...'.",
          "examples": [
            {
              "ja": "お<ruby>茶<rt>ちゃ</rt></ruby>を<ruby>飲<rt>の</rt></ruby>みませんか。",
              "romaji": "Ocha o nomimasen ka.",
              "es": "¿No te gustaría beber té verde?"
            },
            {
              "ja": "はい、<ruby>飲<rt>の</rt></ruby>みましょう。",
              "romaji": "Hai, nomimashou.",
              "es": "Sí, ¡bebamos!"
            }
          ]
        },
        "exercises": [
            {
                "type": "cloze",
                "es": "¿No te gustaría ir al cine?",
                "ja_template": "映画 へ 行き[?]。",
                "expected": "ませんか",
                "distractors": ["ましょう", "ますか", "ましたか"]
            },
            {
                "type": "scramble",
                "es": "¡Comamos sushi!",
                "expected": ["お寿司", "を", "食べましょう"],
                "distractors": ["食べませんか", "が"]
            }
        ]
      },
      {
