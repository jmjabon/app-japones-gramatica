  {
    "block_id": "g_block_03",
    "block_title": "Bloque 3: La Forma TE",
    "themes": [
      {
        "theme_id": "g_tema_3_1",
        "theme_title": "Reglas de la Forma TE",
        "status": "locked",
        "theory": {
          "formula": "<span class='color-verbo'>G1: -って, -んで, -いて...</span> | <span class='color-verbo'>G2: -て</span>",
          "explanation": "La Forma TE conecta verbos y crea estructuras avanzadas. <br><br><b>Grupo 2:</b> Quita 'masu' y pon 'te' (tabe-te).<br><b>Grupo 3:</b> shimasu -> shite, kimasu -> kite.<br><b>Grupo 1 (La regla dura):</b> Depende de la sílaba antes de masu:<br>- i, chi, ri -> って (tte)<br>- mi, bi, ni -> んで (nde)<br>- ki -> いて (ite) / gi -> いで (ide)<br><i>*Excepción: ikimasu (ir) -> itte.</i>",
          "examples": [
            {
              "ja": "見ます -> <ruby>見<rt>み</rt></ruby>て",
              "romaji": "mimasu -> mite",
              "es": "Mirar (G2: directo a 'te')"
            },
            {
              "ja": "飲みます -> <ruby>飲<rt>の</rt></ruby>んで",
              "romaji": "nomimasu -> nonde",
              "es": "Beber (G1: 'mi' cambia a 'nde')"
            }
          ]
        },
        "exercises": [
            {
                "type": "classifier",
                "instruction": "Clasifica cómo termina la Forma TE de estos verbos del Grupo 1",
                "categories": ["-って (tte)", "-んで (nde)", "-いて/いで (ite/ide)"],
                "items": [
                    { "word": "買います (kai-masu)", "expected": "-って (tte)", "rule": "Termina en 'i', por lo que cambia a 'tte' (katte)." },
                    { "word": "読みます (yomi-masu)", "expected": "-んで (nde)", "rule": "Termina en 'mi', por lo que cambia a 'nde' (yonde)." },
                    { "word": "聞きます (kiki-masu)", "expected": "-いて/いで (ite/ide)", "rule": "Termina en 'ki', por lo que cambia a 'ite' (kiite)." },
                    { "word": "待ちます (machi-masu)", "expected": "-って (tte)", "rule": "Termina en 'chi', por lo que cambia a 'tte' (matte)." }
                ]
            },
            {
                "type": "forge",
                "instruction": "Forja la Forma TE correcta",
